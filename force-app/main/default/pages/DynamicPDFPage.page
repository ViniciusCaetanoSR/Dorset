<apex:page renderAs="pdf" controller="PdfContentController" applyBodyTag="false">

  <head>
    <style type="text/css" media="print">
      @page {
        size: A4;
        margin: 0in;
      }

      body {
        margin: 0;
        padding: 0;
      }

      .content {
        width: 100%;
        height: 100%;
      }

      h2 {
        font-family: 'Arial', Helvetica, sans-serif !important;
      }
    </style>
  </head>
  <div class="header">
    <img style="width: 100%;" src="{!$Resource.headerPO}" />
  </div>

  <div style="margin-top: 0; font-family: Arial; padding: 0 60px;">
    <div class="titulo">
      <apex:outputText escape="false" value="{!titulo}" />
    </div>
    <div style="font-size: 12px; font-family: Arial, Helvetica, sans-serif; color: #12215D; line-height: 3; ">
      <apex:outputText escape="false" value="{!decodedContent}" />
    </div>
    <div style=" margin-top: 40px;">
      <img style="width: 30%; margin-top: 2px; border-width: 0 0 1px 0; border-style: solid; border-color: #12215D;"
        src="{!$Resource.patriciaSignature}" />
      <span style="color: #12215D; font-size: 12px; font-family: 'Arial', Helvetica, sans-serif !important;">
        <br />Ms. Patricia Enzweiler
        <br />Director of International Relations
      </span>
    </div>
    <div style="position: fixed; width: 100%; height: 150px;">
      <apex:outputPanel rendered="{!exibirQrCode}">
        <img src="{!$Resource.dorsetStamp}" alt="Dorset Stamp"
          style="position: absolute; right: 220px; width: 150px; height: 150px; top: 10px;" />
        <img src="{!qrCodeUrl}" alt="QR Code"
          style="position: absolute; right: 70px; width: 120px; height: 120px; top: 30px;" />
      </apex:outputPanel>

      <apex:outputPanel rendered="{!NOT(exibirQrCode)}">
        <img src="{!$Resource.dorsetStamp}" alt="Dorset Stamp"
          style="position: absolute; right: 110px; width: 150px; height: 150px; top: 0px;" />
      </apex:outputPanel>
    </div>
  </div>
  <div class="footer" style="position: fixed; bottom: 0; width: 100%;">
    <img src="{!$Resource.footerPO}" style="width: 100%; display: block;" />
    <div
      style="position: absolute; bottom: 70px; left: 10px; width: 100%; text-align: center; font-family: 'Arial', Helvetica, sans-serif !important;">
      <span style="font-size: 9px; color: black;">
        Directors: Hugh Hughes B.Sc. Helen Hughes T.Dip.ICTS. Hugh T Hughes B.A. H.Dip.Ed. Computer Training Specialists
        Ltd. Registered
        in the Republic of Ireland No. 178322
      </span>
    </div>
  </div>
</apex:page>