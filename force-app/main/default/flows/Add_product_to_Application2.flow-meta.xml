    <description>Set EFL Weekly prices (updates product Updated checkbox)</description>
    <environments>Default</environments>
    <formulas>
        <name>CheckPricebook</name>
        <dataType>String</dataType>
        <expression>if( CONTAINS({!$Record.Pricebook2.Name},&quot;Non&quot;) , &quot;New&quot;, &quot;Renewal&quot;)</expression>
    </formulas>
    <formulas>
        <name>Create_productNumber</name>
        <dataType>String</dataType>
        <expression>{!$Record.ProductNumber__c}  + &quot;_&quot;  +
IF (len(TEXT(MOD(FLOOR(({!$Record.EL_Proposed_Start_Date__c} -DATEVALUE(TEXT(YEAR({!$Record.EL_Proposed_Start_Date__c} ))+&quot;-01-01&quot;))/7),52)+1)) = 1,
&quot;0&quot; + TEXT(MOD(FLOOR(({!$Record.EL_Proposed_Start_Date__c} -DATEVALUE(TEXT(YEAR({!$Record.EL_Proposed_Start_Date__c} ))+&quot;-01-01&quot;))/7),52)+1),
TEXT(MOD(FLOOR(({!$Record.EL_Proposed_Start_Date__c} -DATEVALUE(TEXT(YEAR({!$Record.EL_Proposed_Start_Date__c} ))+&quot;-01-01&quot;))/7),52)+1)
)

+ &quot;_&quot;+ TEXT(YEAR({!$Record.EL_Proposed_Start_Date__c} ))</expression>
    </formulas>
    <formulas>
        <name>ELWeeklyPriceCalculation</name>
        <dataType>Currency</dataType>
        <expression>IF(VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)) &gt; 24 , NULL,
{!$Record.Weekly_price__c} * VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)) )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>GetProductNumber</name>
        <dataType>String</dataType>
        <expression>left({!$Record.ProductNumber__c},3)</expression>
    </formulas>
    <formulas>
        <name>Weeks</name>
        <dataType>Number</dataType>
        <expression>value(SUBSTITUTE(left({!$Record.WeeksDuration__c},3),&quot; &quot;,&quot;&quot;))</expression>
        <scale>0</scale>
    </formulas>
