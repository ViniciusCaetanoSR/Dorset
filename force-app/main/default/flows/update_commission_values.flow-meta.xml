    <formulas>
        <name>Calcualte_reneweal_totalNet</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Agent_Net_Amount__c} + ({!loop_Opportunity_Products.TotalPrice} -{!Renewal_Discount}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Calculate_Net_New_fixed</name>
        <dataType>Currency</dataType>
        <expression>(({!loop_Opportunity_Products.TotalPrice} - {!NewFixedDiscount}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Calculate_Net_Renewal_percent</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Agent_Net_Amount__c} + {!RenewalPercentageDiscount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculateNetAmountrenewalFixed</name>
        <dataType>Currency</dataType>
        <expression>( ({!loop_Opportunity_Products.TotalPrice} - {!RenewalFixedDiscount}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatenetNewFixed</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Agent_Net_Amount__c} + {!NewFixedDiscount})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>CalculateNewGrossAmount</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Agent_Gross_Amout__c} + {!loop_Opportunity_Products.TotalPrice})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculateNewTotalNet_newPercent</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Agent_Net_Amount__c} + ({!loop_Opportunity_Products.TotalPrice} - {!NewPercentageDiscount}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NewFixedDiscount</name>
        <dataType>Currency</dataType>
        <expression>({!loop_Opportunity_Products.Quantity} * {!Commission.New_Fixed_Commission_Value__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NewPercentageDiscount</name>
        <dataType>Currency</dataType>
        <expression>(({!loop_Opportunity_Products.TotalPrice} + {!$Record.Discount1__c})* {!Commission.New_Percentage_Commission_Value__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NewPercentDiscount_nodiscount</name>
        <dataType>Currency</dataType>
        <expression>({!loop_Opportunity_Products.TotalPrice} * {!Commission.New_Percentage_Commission_Value__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Renewal_Discount</name>
        <dataType>Currency</dataType>
        <expression>({!loop_Opportunity_Products.TotalPrice} + {!$Record.Discount1__c}) * {!Commission.Renewal_Percentage_Commission_Value__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RenewalFixedDiscount</name>
        <dataType>Currency</dataType>
        <expression>({!loop_Opportunity_Products.Quantity} *  {!Commission.Renewal_Fixed_Commission_Value__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RenewalPercentageDiscount</name>
        <dataType>Currency</dataType>
        <expression>{!loop_Opportunity_Products.TotalPrice} * {!Commission.Renewal_Percentage_Commission_Value__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>ZeroCommissionAdded</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.Agent_Net_Amount__c} + {!loop_Opportunity_Products.TotalPrice})</expression>
        <scale>2</scale>
    </formulas>
