    <formulas>
        <name>ELWeeklyPriceCalculation</name>
        <dataType>Currency</dataType>
        <expression>IF(VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)) &gt; 24 , NULL,
	IF(VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)) &lt; 5,{!$Record.Weekly_price__c} * VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)) ,
		IF(VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)) &lt; 11,round(({!$Record.Weekly_price__c} * 0.9) * VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)),2)
			,round(({!$Record.Weekly_price__c} * 0.85)* VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)),2)
)
)
)</expression>
        <scale>2</scale>
    </formulas>
