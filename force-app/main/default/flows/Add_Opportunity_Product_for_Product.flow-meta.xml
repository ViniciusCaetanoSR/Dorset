    <formulas>
        <name>CheckPricebook</name>
        <dataType>String</dataType>
        <expression>if( CONTAINS({!$Record.Pricebook2.Name},&quot;Non&quot;) , &quot;New&quot;, &quot;Renewal&quot;)</expression>
    </formulas>
    <formulas>
        <name>EFL_end_Date</name>
        <dataType>Date</dataType>
        <expression>IF (left({!$Record.WeeksDuration__c},2) &lt;&gt;&quot;25&quot;,
IF (AND({!$Record.EL_Proposed_Start_Date__c}  &lt; Date(2022,12,04),({!$Record.EL_Proposed_Start_Date__c}  + (7*
VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)))  &gt; date(2022,12,11)) ),
({!$Record.EL_Proposed_Start_Date__c}  + (7*
(VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;))+4))),({!$Record.EL_Proposed_Start_Date__c}  + (7*
VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)))))
,{!$Record.Product__r.End_Date__c})</expression>
    </formulas>
    <formulas>
        <name>ELWeeklyPriceCalculation</name>
        <dataType>Currency</dataType>
        <expression>IF(VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)) &gt; 24 , NULL,
{!$Record.Weekly_price__c} * VALUE(SUBSTITUTE(left({!$Record.WeeksDuration__c},2),&quot; &quot;,&quot;&quot;)) )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NewSummaryname</name>
        <dataType>String</dataType>
        <expression>left({!$Record.Name} + &quot; - &quot; + {!$Record.Product__r.Name} + &quot; - &quot; + text({!$Record.Product__r.Start_Date__c}),119)</expression>
    </formulas>
