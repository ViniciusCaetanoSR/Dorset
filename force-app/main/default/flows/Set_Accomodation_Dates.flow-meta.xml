    <formulas>
        <name>CalcPeakDays</name>
        <dataType>Number</dataType>
        <expression>IF (month({!$Record.Accommodation_Arrival_Date__c}) &gt; 8
,0,
if( {!$Record.Accommodation_End_Date__c} &lt; date(year({!$Record.Accommodation_End_Date__c}),5,31)
,0,
IF (AND(month({!$Record.Accommodation_End_Date__c}) &gt;8,( {!$Record.Accommodation_Arrival_Date__c} &lt; date(year({!$Record.Accommodation_Arrival_Date__c}),5,31)))
,91,
IF (AND( month({!$Record.Accommodation_Arrival_Date__c}) &gt; 5 ,month({!$Record.Accommodation_End_Date__c}) &lt;9)
,({!$Record.Accommodation_End_Date__c} - {!$Record.Accommodation_Arrival_Date__c}),
IF (AND( month({!$Record.Accommodation_Arrival_Date__c}) &gt; 5 ,month({!$Record.Accommodation_End_Date__c}) &gt; 8),
date(year({!$Record.Accommodation_End_Date__c}),8,31)  - {!$Record.Accommodation_Arrival_Date__c} ,
{!$Record.Accommodation_End_Date__c} - date(year({!$Record.Accommodation_End_Date__c}),5,31))
)
)
)
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
