    </formulas>
    <formulas>
        <name>SetOffPeaksDays</name>
        <dataType>Number</dataType>
        <expression>if
	( {!$Record.Accommodation_End_Date__c} &lt; date(year({!$Record.Accommodation_End_Date__c}),5,31)
		,{!$Record.Accommodation_End_Date__c} - {!$Record.Accommodation_Arrival_Date__c},
			IF (AND(month({!$Record.Accommodation_End_Date__c}) &gt;8,{!$Record.Accommodation_Arrival_Date__c} &lt; date(year({!$Record.Accommodation_Arrival_Date__c}),5,31)),
						{!$Record.Accommodation_End_Date__c} - {!$Record.Accommodation_Arrival_Date__c} - 91,
						IF (AND( month({!$Record.Accommodation_Arrival_Date__c}) &gt; 5 ,month({!$Record.Accommodation_End_Date__c}) &lt;9)
						,0,
							IF (AND( month({!$Record.Accommodation_Arrival_Date__c}) &gt; 8 ,month({!$Record.Accommodation_End_Date__c}) &gt; 8),
{!$Record.Accommodation_End_Date__c} - {!$Record.Accommodation_Arrival_Date__c}
,IF (AND(month({!$Record.Accommodation_End_Date__c}) &gt;5,{!$Record.Accommodation_Arrival_Date__c} &lt; date(year({!$Record.Accommodation_Arrival_Date__c}),5,31),(month({!$Record.Accommodation_End_Date__c}) &lt; 9)),
 (date(year({!$Record.Accommodation_End_Date__c}),5,31))  - {!$Record.Accommodation_Arrival_Date__c} , {!$Record.Accommodation_End_Date__c} - (date(year({!$Record.Accommodation_End_Date__c}),8,31))


				)				
								)
							)
				)
)</expression>
