    <description>Added &quot;Receipt Code&quot; field transfer from opportunity</description>
    <formulas>
        <name>BalanceAmount</name>
        <dataType>Currency</dataType>
        <expression>({!StoredPaymentPlan.Total_Amount1__c}-{!PaymentAmount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>BiMonthlyDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() +((365/12)*2* {!LoopNum})</expression>
    </formulas>
    <formulas>
        <name>BiWeeklyDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() +(2*7* {!LoopNum})</expression>
    </formulas>
    <formulas>
        <name>MonthlyDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() +((365/12)* {!LoopNum})</expression>
    </formulas>
    <formulas>
        <name>NoofPayments</name>
        <dataType>Number</dataType>
        <expression>IF({!Get_Payment_Plan_details.Related_Opportunity__r.Deposit_Required__c},
{!Get_Payment_Plan_details.No_of_Payments_Expected__c} - 1,
{!Get_Payment_Plan_details.No_of_Payments_Expected__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PaymentAmount</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Payment_Plan_details.Balance1__c}/ IF({!Get_Payment_Plan_details.Related_Opportunity__r.Deposit_Required__c},
{!Get_Payment_Plan_details.No_of_Payments_Expected__c} - 1,
{!Get_Payment_Plan_details.No_of_Payments_Expected__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>WeeklyDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() +(7* {!LoopNum})</expression>
    </formulas>
